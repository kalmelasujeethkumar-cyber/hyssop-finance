# HYSSOP FINANCE — environment template
# Copy this file to `.env` in the repository root and replace placeholders with local values.
# `.env` is git-ignored and must never be committed. Never place secrets in this file.
# Only `VITE_`-prefixed values are read by the browser bundle; all other values stay on the server.

# ---------------------------------------------------------------------------
# Required in Phase 01 (foundation)
# ---------------------------------------------------------------------------

# API port (1-65535). `NODE_ENV` is not configured here: the API defaults to
# `development` and the browser build must always be a production build.
PORT=3000

# Exact browser origins allowed to call the API. Comma-separated, no `*`.
# The web dev/preview server is bound to 127.0.0.1, so open it on that host.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Base URL the browser uses to reach the API. Vite-prefixed, therefore public to the client.
# The default is the same-origin path, so the browser calls the dev/preview server and the
# server-side proxy forwards `/api` to `API_PROXY_TARGET`. Set an absolute URL instead when
# the API is served from a different origin; that origin must be listed in CORS_ALLOWED_ORIGINS.
# Required for a production build; the build fails fast when it is missing.
VITE_API_BASE_URL=/api/v1

# Server-side target for the `/api` proxy used by `npm run dev` and `npm run preview`.
# Never sent to the browser. Must match the API's PORT.
API_PROXY_TARGET=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Required in Phase 02 (database)
# ---------------------------------------------------------------------------

# Least-privilege runtime connection used by the API and by database tests. Never a
# superuser. It holds no `UPDATE`/`DELETE` privilege on `audit_event`.
# The default values below match `npm run db:start` (project-local cluster in
# `tmp/pgdata`, loopback only, port 55432, trust authentication, so no password).
DATABASE_URL=postgresql://hyssop_app@127.0.0.1:55432/hyssop_finance_dev?schema=public

# Schema-owner connection used only by `npm run db:migrate` (`prisma migrate deploy`).
# The running API never uses it. Keep it out of any deployed runtime configuration.
DIRECT_DATABASE_URL=postgresql://hyssop_migrator@127.0.0.1:55432/hyssop_finance_dev?schema=public

# ---------------------------------------------------------------------------
# Locked product constants (no override required)
# ---------------------------------------------------------------------------

# Business timezone for all business dates
APP_TIMEZONE=Asia/Kolkata

# Only supported currency
CURRENCY=INR

# ---------------------------------------------------------------------------
# Reserved for later phases — not required by Phase 02
# Phase 03 session/authentication, Phase 07 document storage
# ---------------------------------------------------------------------------

# SESSION_COOKIE_NAME=hyssop_session
# SESSION_TTL_HOURS=8
# STORAGE_DRIVER=local
# LOCAL_STORAGE_PATH=./storage/uploads
# UPLOAD_MAX_BYTES=10485760
#
# Docker/Compose only (`docker-compose.yml`): set a real password before use.
# POSTGRES_PASSWORD=replace-me
