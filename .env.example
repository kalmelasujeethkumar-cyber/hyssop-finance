# HYSSOP FINANCE — environment template
# Copy this file to `.env` in the repository root and replace placeholders with local values.
# `.env` is git-ignored and must never be committed. Never place secrets in this file.
# Only `VITE_`-prefixed values are read by the browser bundle; all other values stay on the server.

# ---------------------------------------------------------------------------
# Required in Phase 01 (foundation)
# ---------------------------------------------------------------------------

# API port (1-65535). `NODE_ENV` is not configured here: the API defaults to
# `development` and the browser build must always be a production build.
PORT=3000

# Exact browser origins allowed to call the API. Comma-separated, no `*`.
# The web dev/preview server is bound to 127.0.0.1, so open it on that host.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Base URL the browser uses to reach the API. Vite-prefixed, therefore public to the client.
# The default is the same-origin path, so the browser calls the dev/preview server and the
# server-side proxy forwards `/api` to `API_PROXY_TARGET`. Set an absolute URL instead when
# the API is served from a different origin; that origin must be listed in CORS_ALLOWED_ORIGINS.
# Required for a production build; the build fails fast when it is missing.
VITE_API_BASE_URL=/api/v1

# Server-side target for the `/api` proxy used by `npm run dev` and `npm run preview`.
# Never sent to the browser. Must match the API's PORT.
API_PROXY_TARGET=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Required in Phase 02 (database)
# ---------------------------------------------------------------------------

# Least-privilege runtime connection used by the API and by database tests. Never a
# superuser. It holds no `UPDATE`/`DELETE` privilege on `audit_event`.
# The default values below match `npm run db:start` (project-local cluster in
# `tmp/pgdata`, loopback only, port 55432, trust authentication, so no password).
DATABASE_URL=postgresql://hyssop_app@127.0.0.1:55432/hyssop_finance_dev?schema=public

# Schema-owner connection used only by `npm run db:migrate` (`prisma migrate deploy`).
# The running API never uses it. Keep it out of any deployed runtime configuration.
DIRECT_DATABASE_URL=postgresql://hyssop_migrator@127.0.0.1:55432/hyssop_finance_dev?schema=public

# ---------------------------------------------------------------------------
# Locked product constants (no override required)
# ---------------------------------------------------------------------------

# Business timezone for all business dates
APP_TIMEZONE=Asia/Kolkata

# Only supported currency
CURRENCY=INR

# ---------------------------------------------------------------------------
# Required in Phase 03 (authentication)
# ---------------------------------------------------------------------------

# Login identifier of the single Admin. Stored lower-cased and unique. The
# bootstrap and the login form both normalize it, so `Admin` and `admin` are one
# account. There is exactly one Admin; the unique identifier prevents a second.
HYSSOP_ADMIN_IDENTIFIER=admin

# Password for the single Admin, used ONLY by `npm run admin:bootstrap`.
# The running API never reads it. Leave it unset for normal API, test, and build
# runs, and never commit a real value. Minimum 12 characters, maximum 128.
# HYSSOP_ADMIN_PASSWORD=

# Opaque session cookie name and absolute session lifetime in hours.
SESSION_COOKIE_NAME=hyssop_session
SESSION_TTL_HOURS=8

# Pre-authentication CSRF cookie. This cookie is intentionally NOT HTTP-only
# because the browser must echo the value in the `X-CSRF-Token` header; the
# session cookie above is always HTTP-only.
CSRF_COOKIE_NAME=hyssop_csrf
CSRF_TTL_MINUTES=15

# Cookie policy. `SameSite=Lax` is correct for the documented same-origin
# deployment, where the browser calls the web origin and a server-side proxy
# forwards `/api`. A cross-site deployment needs `SameSite=None` together with
# `COOKIE_SECURE=true` and an explicit origin in CORS_ALLOWED_ORIGINS.
SESSION_COOKIE_SAME_SITE=Lax

# Send the `Secure` attribute. Keep `false` for the local HTTP demo. Any HTTPS
# deployment, including Phase 12, must set `true`.
COOKIE_SECURE=false

# Argon2id cost. The defaults are the OWASP minimum for Argon2id (19 MiB, two
# iterations, one lane) and are deliberately not raised, so the demo stays
# responsive on modest hardware.
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# Login abuse controls. A failed attempt is recorded against a hash of the
# identifier and the client address, and exceeding the window returns the same
# generic message as a wrong password.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# General request-abuse ceilings (Phase 12). Each value is the maximum number of
# requests one client may make in the shared window for that category; exceeding it
# returns the generic `429 RATE_LIMITED` envelope with a `Retry-After` header.
# `MUTATION` covers every state-changing method, `UPLOAD` the document upload route,
# and `SEARCH`/`EXPORT` the read routes of the same names. The defaults are generous
# because the demo has a single Admin; tighten them for a real deployment. Login is
# covered by the dedicated control above, not by these.
RATE_LIMIT_WINDOW_MINUTES=1
MUTATION_RATE_LIMIT_MAX_REQUESTS=300
SEARCH_RATE_LIMIT_MAX_REQUESTS=300
UPLOAD_RATE_LIMIT_MAX_REQUESTS=120
EXPORT_RATE_LIMIT_MAX_REQUESTS=120

# ---------------------------------------------------------------------------
# Reserved for later phases — not required by Phase 03
# Phase 07 document storage
# ---------------------------------------------------------------------------

# STORAGE_DRIVER=local
# LOCAL_STORAGE_PATH=./storage/uploads
# UPLOAD_MAX_BYTES=10485760
#
# Docker/Compose only (`docker-compose.yml`): set a real password before use.
# POSTGRES_PASSWORD=replace-me
